{
  "name": "optics-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Optics Shop Billing & Management System",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "desktop",
    "download-site"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "db:generate": "npm run db:generate -w backend",
    "db:push": "npm run db:push -w backend",
    "db:studio": "npm run db:studio -w backend",
    "dev:desktop": "npm run dev -w desktop",
    "build:desktop": "npm run build -w desktop",
    "dev:download": "npm run dev -w download-site",
    "build:download": "npm run build -w download-site",
    "prepare": "husky || true"
  },
  "dependencies": {
    "electron": "^31.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7"
  }
}
